# Environment variables (none required for client-only operation)
# Google Analytics 4 Measurement ID (optional - can also be configured in Admin Panel)
VITE_GA_MEASUREMENT_ID=
# Google Tag Manager Container ID (optional - can also be configured in Admin Panel)
VITE_GTM_ID=
# Meta / Facebook Pixel ID (optional - can also be configured in Admin Panel)
VITE_FB_PIXEL_ID=1672750902853465
