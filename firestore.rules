rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for admin check
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'nabiulislam609@gmail.com' ||
        request.auth.token.email.lower() == 'aicourse.nabin@gmail.com'
      );
    }

    // Public readable collections (School Directory, Academics, Announcements, Results)
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /deleted_students/{studentId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{albumId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exam_results/{resultId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /school_config/{configDocId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Public submissions with admin management
    match /admissions/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Default deny for unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
